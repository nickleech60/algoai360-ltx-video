{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "ltxv-13b-0.9.7-dev-fp8.safetensors" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "t5xxl_fp8_e4m3fn.safetensors", "type": "ltxv" }
  },
  "lat": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": 768, "height": 512, "length": 97, "batch_size": 1 }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["clip", 0] }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "worst quality, blurry, jittery, distorted, deformed, watermark, text, low quality", "clip": ["clip", 0] }
  },
  "cond": {
    "class_type": "LTXVConditioning",
    "inputs": { "positive": ["pos", 0], "negative": ["neg", 0], "frame_rate": 24 }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["ckpt", 0],
      "positive": ["cond", 0],
      "negative": ["cond", 1],
      "latent_image": ["lat", 0],
      "seed": 7,
      "steps": 30,
      "cfg": 3.2,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "dec": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["ks", 0],
      "vae": ["ckpt", 2],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 16,
      "temporal_overlap": 4
    }
  },
  "save": {
    "class_type": "SaveWEBM",
    "inputs": {
      "images": ["dec", 0],
      "filename_prefix": "algoai360ltx",
      "codec": "vp9",
      "fps": 24,
      "crf": 20
    }
  }
}
